import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D18V6DOriginalUnitPairMatrixWitnessProbe
import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D18SOriginalSpinSpecialOrthogonalWitnessHomKernelProbe

/-!
K1D18V7A — exact source SO image-generation boundary.

The accepted V6D matrix action permits a source SO element to be
characterized by its pointwise action as a pair of actual original
source rank-one matrices (not a surrogate Euclidean reflection).

We prove these source-matrix pair elements belong to the image of
the ACCEPTED genuine Spin-to-source-SO homomorphism, and therefore
the subgroup generated by such pair elements is contained in its
image. We identify the precise *remaining* generation hypothesis
under which this would imply surjectivity, but we DO NOT prove that
hypothesis.

Original Q, 48 label order, witness SO group, and accepted Spin
homomorphism are all unchanged. No covering, canonical O(48)
transport, global Spin9, or physical BFSS claims are established.
CANDIDATES until warning-as-error strict CI and axiom audit.
-/

set_option autoImplicit false

namespace FCP.BFSSS1V52K1D18V7A
noncomputable section
open FCP.BFSSS1V0
open Matrix

private abbrev Q : QuadraticForm ℝ Source48Vector := source48Quadratic
private abbrev GL48 := Source48Vector ≃ₗ[ℝ] Source48Vector
private abbrev SourceSO :=
  FCP.BFSSS1V52K1D18R.source48SpecialOrthogonalWitnessGL
private abbrev sourceSOHom : spinGroup Q →* SourceSO :=
  FCP.BFSSS1V52K1D18S.originalSourceSpin48SpecialOrthogonalWitnessRepresentation

/-- Set of genuine source-SO elements whose ACTUAL action agrees,
at every original 48-label input, with a product of two accepted
source Q-unit line-reflection matrices. Defined without referencing
any Spin image, so its generation is a separately testable claim. -/
def sourceSOUnitPairMatrixSet : Set SourceSO :=
  {g | ∃ (u v : Source48Vector) (hu : Q u = 1) (hv : Q v = 1),
    ∀ w : Source48Vector, (g : GL48) w =
      FCP.BFSSS1V52K1D18V6D.originalSourceUnitRankOneMatrix u hu *ᵥ
        (FCP.BFSSS1V52K1D18V6D.originalSourceUnitRankOneMatrix v hv *ᵥ w)}

/-- The genuine source SO representation of a constructed Spin pair
has literally its accepted original source-matrix action. -/
theorem originalSourceSpinPairSO_image_matrix_action
    (u v w : Source48Vector) (hu : Q u = 1) (hv : Q v = 1) :
    ((sourceSOHom (FCP.BFSSS1V52K1D18V6C.originalSourceUnitPairSpin u v hu hv) :
      SourceSO) : GL48) w =
      FCP.BFSSS1V52K1D18V6D.originalSourceUnitRankOneMatrix u hu *ᵥ
        (FCP.BFSSS1V52K1D18V6D.originalSourceUnitRankOneMatrix v hv *ᵥ w) := by
  change FCP.BFSSS1V31.sourceSpin48VectorAction
    (FCP.BFSSS1V52K1D18V6C.originalSourceUnitPairSpin u v hu hv) w = _
  exact FCP.BFSSS1V52K1D18V6D.originalSourceUnitPairSpin_action_no_instance_premises
    u v w hu hv

/-- Every source SO element acting as an ORIGINAL unit-pair
matrix is in the image of the EXISTING source Spin-to-SO map.
This is a pointwise source-typed action identification, NOT
an assumption that arbitrary SO matrices have such a form. -/
theorem sourceSOUnitPairMatrixSet_subset_sourceSpinImage :
    sourceSOUnitPairMatrixSet ⊆ (sourceSOHom.range : Set SourceSO) := by
  intro g hg
  rcases hg with ⟨u, v, hu, hv, hmatrix⟩
  have heq :
      g = sourceSOHom
        (FCP.BFSSS1V52K1D18V6C.originalSourceUnitPairSpin u v hu hv) := by
    apply Subtype.ext
    apply LinearEquiv.ext
    intro w
    exact (hmatrix w).trans
      (originalSourceSpinPairSO_image_matrix_action u v w hu hv).symm
  rw [heq]
  exact ⟨FCP.BFSSS1V52K1D18V6C.originalSourceUnitPairSpin u v hu hv, rfl⟩

/-- All finite products and inverses generated by original
source SO unit-pair matrix elements lie in the genuine Spin image.
The missing converse is precisely the global generation problem. -/
theorem sourceSOUnitPairMatrixClosure_le_sourceSpinImage :
    Subgroup.closure sourceSOUnitPairMatrixSet ≤ sourceSOHom.range := by
  rw [Subgroup.closure_le]
  exact sourceSOUnitPairMatrixSet_subset_sourceSpinImage

/-- A clear, explicitly conditional image-surjectivity criterion.
The Cartan–Dieudonné/group-generation hypothesis is NOT proved
here; it remains the next standalone obligation. -/
theorem sourceSpinSO_surjective_of_unitPairMatrixGeneration
    (hgen : Subgroup.closure sourceSOUnitPairMatrixSet = ⊤) :
    Function.Surjective sourceSOHom := by
  intro g
  have hc : g ∈ Subgroup.closure sourceSOUnitPairMatrixSet := by
    rw [hgen]
    exact Subgroup.mem_top g
  exact sourceSOUnitPairMatrixClosure_le_sourceSpinImage hc

#print axioms sourceSOUnitPairMatrixSet
#print axioms originalSourceSpinPairSO_image_matrix_action
#print axioms sourceSOUnitPairMatrixSet_subset_sourceSpinImage
#print axioms sourceSOUnitPairMatrixClosure_le_sourceSpinImage
#print axioms sourceSpinSO_surjective_of_unitPairMatrixGeneration

end
end FCP.BFSSS1V52K1D18V7A
