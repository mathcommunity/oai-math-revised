/-- Genuine source gamma Spin9 matrix determinant is
multiplicative: use the accepted subtype group hom
without introducing any composed determinant character. -/
theorem gammaDet_mul (g h : spinGroup source9Quadratic) :
    (((source9SpinGammaOrthogonalHom (g * h)) : GammaMatrix).det) =
      (((source9SpinGammaOrthogonalHom g) : GammaMatrix).det) *
      (((source9SpinGammaOrthogonalHom h) : GammaMatrix).det) := by
  have hm :
      ((source9SpinGammaOrthogonalHom (g * h)) : GammaMatrix) =
        ((source9SpinGammaOrthogonalHom g) : GammaMatrix) *
        ((source9SpinGammaOrthogonalHom h) : GammaMatrix) := by
    exact congrArg
      (fun A : Matrix.orthogonalGroup SpinIndex ℝ => (A : GammaMatrix))
      (map_mul source9SpinGammaOrthogonalHom g h)
  rw [hm, Matrix.det_mul]

/-- The actual source Spin9 gamma image of any GROUP
SQUARE has determinant +1. F1 handles det^2=1. -/
theorem gammaDet_square_one (g : spinGroup source9Quadratic) :
    (((source9SpinGammaOrthogonalHom (g * g)) : GammaMatrix).det) = 1 := by
  rw [gammaDet_mul g g]
  simpa only [pow_two] using gammaDetSquareOne g

/-- The source-exact original G1A paired48 image of any
Spin9 GROUP SQUARE belongs to special orthogonal 48.
No square-generation or continuity hypothesis is assumed. -/
theorem originalPaired48_mem_SO_of_square
    (g : spinGroup source9Quadratic) :
    ((source9SpinOriginalPaired48OrthogonalHom (g * g)) :
      Matrix Source48Label Source48Label ℝ) ∈
      Matrix.specialOrthogonalGroup Source48Label ℝ := by
  exact (pairedSO_iff_gammaDetOne (g * g)).2
    (gammaDet_square_one g)

