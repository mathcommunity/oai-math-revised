    ∃ l : List Euc48,
      l.length ≤ Module.finrank ℝ Euc48 ∧
      φ = (l.map fun v => (ℝ ∙ v)ᗮ.reflection).prod := by
  exact LinearIsometryEquiv.reflections_generate_dim φ

/-- Source-label-typed auxiliary ℝ inner-product orthogonal group
is generated by its Mathlib hyperplane reflections. This is NOT
yet the original source-SO generation equality from V7A. -/
theorem source48Euclidean_reflections_generate :
