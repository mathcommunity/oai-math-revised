/-- A generic, bounded proof for finite all-one coordinate weights,
independent of 48-label unfolding, that Q is L2-norm squared after
an explicit underlying-function-to-EuclideanSpace coercion. -/
theorem weightedSumSquares_one_eq_euclidean_norm_sq
    {ι : Type*} [Fintype ι] (a : ι → ℝ) :
    (QuadraticMap.weightedSumSquares ℝ (fun _ : ι => (1 : ℝ))) a =
      ‖(WithLp.toLp 2 a : EuclideanSpace ℝ ι)‖ ^ 2 := by
  calc
    (QuadraticMap.weightedSumSquares ℝ (fun _ : ι => (1 : ℝ))) a =
        ∑ i, a i * a i := by
          rw [QuadraticMap.weightedSumSquares_apply]
          simp only [one_smul]
    _ = ∑ i, ‖(WithLp.toLp 2 a : EuclideanSpace ℝ ι) i‖ ^ 2 := by
          apply Finset.sum_congr rfl
          intro i _
          change a i * a i = ‖a i‖ ^ 2
          rw [Real.norm_eq_abs, sq_abs, pow_two]
    _ = ‖(WithLp.toLp 2 a : EuclideanSpace ℝ ι)‖ ^ 2 := by
          rw [EuclideanSpace.norm_eq, Real.sq_sqrt]
          exact Finset.sum_nonneg (fun i _ => sq_nonneg _)

/-- EXACT ORIGINAL source quadratic, not another assumed form:
its value equals squared canonical L2 norm after an explicit
typed equivalence of the 48 real coordinates. -/
theorem source48Quadratic_eq_euclidean_norm_sq (a : Source48Vector) :
    Q a = ‖(WithLp.toLp 2 a : Euc48)‖ ^ 2 := by
  have hSourceQ : source48Quadratic =
      QuadraticMap.weightedSumSquares ℝ
        (fun _ : Source48Label => (1 : ℝ)) := rfl
  calc
    Q a = (QuadraticMap.weightedSumSquares ℝ
        (fun _ : Source48Label => (1 : ℝ))) a :=
      congrArg (fun q : QuadraticForm ℝ Source48Vector => q a) hSourceQ
    _ = ‖(WithLp.toLp 2 a : Euc48)‖ ^ 2 :=
      weightedSumSquares_one_eq_euclidean_norm_sq (ι := Source48Label) a

