import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D18V7VOriginalSourceNegativeCentralKernelClosureProbe
import Mathlib.GroupTheory.QuotientGroup.Basic

/-!
K1D18V7W — explicit original negative-central quotient-group
presentation, with exact source-defined group and original
Clifford Spin action.

Accepted V7V: the actual source Spin-to-sourceSO kernel equals
the subgroup generated by the TRUE original negative central
Spin element, and that subgroup has exactly the two signs.
Accepted V7U: the canonical algebraic quotient by this original
source kernel is multiplicatively equivalent to the TRUE
original sourceSO.

This experiment transports the normality instance from the
genuine original kernel, then forms the actual quotient by
the ORIGINAL generated central sign. The isomorphism to original
sourceSO is the V7U canonical quotient composed with pinned
Mathlib quotientMulEquivOfEq, not a new surrogate SO action.
The quotient sends a native original Spin coset to the exact
source-defined Spin-to-sourceSO action.

No topological quotient, continuous map, covering, local
homeomorphism, global Spin9 lift, or BFSS spectral claim.
Three roots CANDIDATE pending fresh source-exact strict CI.
-/

set_option autoImplicit false

namespace FCP.BFSSS1V52K1D18V7W
noncomputable section
open FCP.BFSSS1V0

private abbrev Q : QuadraticForm ℝ Source48Vector := source48Quadratic
private abbrev SourceSO :=
  FCP.BFSSS1V52K1D18R.source48SpecialOrthogonalWitnessGL
private abbrev sourceSOHom : spinGroup Q →* SourceSO :=
  FCP.BFSSS1V52K1D18S.originalSourceSpin48SpecialOrthogonalWitnessRepresentation
private abbrev negativeCentral : spinGroup Q :=
  FCP.BFSSS1V52K1D11.originalSourceNegativeCentral
private abbrev centralClosure : Subgroup (spinGroup Q) :=
  Subgroup.closure ({negativeCentral} : Set (spinGroup Q))

/-- The subgroup generated by the original negative central
Spin element is normal because it IS the kernel of the
already accepted true original source Spin representation. -/
private instance originalSourceNegativeCentralClosureNormal :
    centralClosure.Normal := by
  change (Subgroup.closure ({negativeCentral} : Set (spinGroup Q))).Normal
  rw [← FCP.BFSSS1V52K1D18V7V.originalSourceSpinSO_kernel_eq_negativeCentralClosure]
  infer_instance

/-- The actual original Clifford Spin(48) group modulo the
subgroup generated by its original negative central element
is algebraically equivalent to the ACTUAL original sourceSO. -/
noncomputable def originalSourceSpinSO_quotientNegativeCentralClosureMulEquiv :
    (spinGroup Q ⧸ centralClosure) ≃* SourceSO :=
  (QuotientGroup.quotientMulEquivOfEq
      FCP.BFSSS1V52K1D18V7V.originalSourceSpinSO_kernel_eq_negativeCentralClosure.symm).trans
    FCP.BFSSS1V52K1D18V7U.originalSourceSpin48SO_quotientKernelMulEquiv

/-- The new algebraic quotient maps each TRUE original
Spin element to its SAME original sourceSO representation. -/
theorem originalSourceSpinSO_quotientNegativeCentralClosureMulEquiv_mk
    (s : spinGroup Q) :
    originalSourceSpinSO_quotientNegativeCentralClosureMulEquiv
      (QuotientGroup.mk s : spinGroup Q ⧸ centralClosure) =
        sourceSOHom s := by
  rfl

#print axioms originalSourceSpinSO_quotientNegativeCentralClosureMulEquiv
#print axioms originalSourceSpinSO_quotientNegativeCentralClosureMulEquiv_mk

end
end FCP.BFSSS1V52K1D18V7W
