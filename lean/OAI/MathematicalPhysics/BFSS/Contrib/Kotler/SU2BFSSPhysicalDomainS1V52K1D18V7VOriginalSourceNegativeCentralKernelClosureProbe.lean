import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D18V7UOriginalSourceSpinSOQuotientKernelIsomorphismProbe

/-!
K1D18V7V — source-exact kernel of the actual original
Spin48-to-original-sourceSO action as the subgroup generated
by the ORIGINAL negative central Spin element.

The accepted K1D18S source homomorphism has kernel set
exactly {1, originalSourceNegativeCentral}; accepted K1D11
establishes the original negative central element is nonidentity.
Accepted V7U is a canonical algebraic quotient by THAT kernel.

Here identify the exact kernel SUBGROUP with the subgroup
generated by that genuine original central element, and
identify the closure carrier with the two previously accepted
signs. No substitute Clifford algebra, quadratic form, basis
order, sourceSO action or unsupported topological claim is used.

This does NOT construct a topological double covering, standard
SO48 Lie-group identification, global Spin9 lift or physical
BFSS spectral existence. Both roots CANDIDATE until strict CI.
-/

set_option autoImplicit false

namespace FCP.BFSSS1V52K1D18V7V
noncomputable section
open FCP.BFSSS1V0

private abbrev Q : QuadraticForm ℝ Source48Vector := source48Quadratic
private abbrev SourceSO :=
  FCP.BFSSS1V52K1D18R.source48SpecialOrthogonalWitnessGL
private abbrev sourceSOHom : spinGroup Q →* SourceSO :=
  FCP.BFSSS1V52K1D18S.originalSourceSpin48SpecialOrthogonalWitnessRepresentation
private abbrev negativeCentral : spinGroup Q :=
  FCP.BFSSS1V52K1D11.originalSourceNegativeCentral

/-- The kernel of the ACTUAL original Spin-to-sourceSO group
homomorphism is exactly the subgroup generated by the
ORIGINAL negative central Spin element, not a surrogate ±1. -/
theorem originalSourceSpinSO_kernel_eq_negativeCentralClosure :
    sourceSOHom.ker =
      Subgroup.closure ({negativeCentral} : Set (spinGroup Q)) := by
  have hset :
      (sourceSOHom.ker : Set (spinGroup Q)) =
        ({1, negativeCentral} : Set (spinGroup Q)) :=
    FCP.BFSSS1V52K1D18S.originalSourceSpin48SpecialOrthogonalWitnessRepresentation_ker_eq_two_sign_set
  apply le_antisymm
  · intro s hs
    have hmem : s ∈ ({1, negativeCentral} : Set (spinGroup Q)) := by
      rw [← hset]
      exact hs
    rcases (Set.mem_insert_iff.mp hmem) with hone | hneg
    · rw [hone]
      exact (Subgroup.closure ({negativeCentral} : Set (spinGroup Q))).one_mem
    · rw [Set.mem_singleton_iff.mp hneg]
      exact Subgroup.subset_closure (Set.mem_singleton negativeCentral)
  · rw [Subgroup.closure_le]
    intro s hs
    have hs' : s = negativeCentral := Set.mem_singleton_iff.mp hs
    rw [hs']
    change negativeCentral ∈ (sourceSOHom.ker : Set (spinGroup Q))
    rw [hset]
    simp

/-- The carrier of this actual generated subgroup has exactly
the previously classified two original signs. -/
theorem originalSourceSpinSO_negativeCentralClosure_eq_twoSignSet :
    ((Subgroup.closure ({negativeCentral} : Set (spinGroup Q))) :
      Set (spinGroup Q)) =
        ({1, negativeCentral} : Set (spinGroup Q)) := by
  rw [← originalSourceSpinSO_kernel_eq_negativeCentralClosure]
  exact FCP.BFSSS1V52K1D18S.originalSourceSpin48SpecialOrthogonalWitnessRepresentation_ker_eq_two_sign_set

#print axioms originalSourceSpinSO_kernel_eq_negativeCentralClosure
#print axioms originalSourceSpinSO_negativeCentralClosure_eq_twoSignSet

end
end FCP.BFSSS1V52K1D18V7V
