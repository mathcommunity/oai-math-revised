import Mathlib.Analysis.Complex.Basic
import Mathlib.Analysis.Normed.Module.Basic
import Mathlib.Topology.Algebra.Module.LinearPMap

/-!
M4F7 B2 — generic opaque closed-graph operator certificate.
All declarations are abstract normed complex modules and an opaque
submodule S. NO BFSS definitions or source-specialization inside proofs.

These are supporting theorems. Their successful compilation would
not qualify an actual independent BFSS closed charge operator.
-/

set_option autoImplicit false
set_option maxHeartbeats 100000

namespace FCP.M4F7GenericOpaqueClosedRelationBridge
noncomputable section

variable {X Y : Type*}
  [NormedAddCommGroup X] [NormedSpace ℂ X]
  [NormedAddCommGroup Y] [NormedSpace ℂ Y]

/-- Under a generic vertical-fiber certificate on the SET closure of an
opaque complex-linear relation S, its native submodule closure has
the identical vertical-fiber uniqueness property. -/
theorem topologicalClosure_vertical_of_set
    (S : Submodule ℂ (X × Y))
    (hVertical : ∀ p : X × Y,
      p ∈ closure (S : Set (X × Y)) → p.1 = 0 → p.2 = 0) :
    ∀ p : X × Y, p ∈ S.topologicalClosure → p.1 = 0 → p.2 = 0 := by
  intro p hp hzero
  apply hVertical p ?_ hzero
  rw [← Submodule.topologicalClosure_coe S]
  exact hp

/-- The minimal closed graph generated by any opaque complex relation
with trivial vertical fiber is exactly a genuine LinearPMap graph. -/
theorem topologicalClosure_toLinearPMap_graph_eq
    (S : Submodule ℂ (X × Y))
    (hVertical : ∀ p : X × Y,
      p ∈ closure (S : Set (X × Y)) → p.1 = 0 → p.2 = 0) :
    (S.topologicalClosure.toLinearPMap).graph = S.topologicalClosure := by
  exact Submodule.toLinearPMap_graph_eq S.topologicalClosure
    (topologicalClosure_vertical_of_set S hVertical)

/-- The genuinely minimal partially-defined operator from the closed
relation has a closed graph. No density, physical-output or spectrum
hypothesis is present or implied. -/
theorem topologicalClosure_toLinearPMap_isClosed
    (S : Submodule ℂ (X × Y))
    (hVertical : ∀ p : X × Y,
      p ∈ closure (S : Set (X × Y)) → p.1 = 0 → p.2 = 0) :
    (S.topologicalClosure.toLinearPMap).IsClosed := by
  change IsClosed ((S.topologicalClosure.toLinearPMap).graph :
    Set (X × Y))
  rw [topologicalClosure_toLinearPMap_graph_eq S hVertical]
  exact Submodule.isClosed_topologicalClosure S

#print axioms topologicalClosure_vertical_of_set
#print axioms topologicalClosure_toLinearPMap_graph_eq
#print axioms topologicalClosure_toLinearPMap_isClosed

end
end FCP.M4F7GenericOpaqueClosedRelationBridge
