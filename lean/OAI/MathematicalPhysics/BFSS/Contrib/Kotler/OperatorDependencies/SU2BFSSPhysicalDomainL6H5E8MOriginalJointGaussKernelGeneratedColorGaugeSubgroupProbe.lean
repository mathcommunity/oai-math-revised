import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.OperatorDependencies.SU2BFSSPhysicalDomainL6H5E8LOriginalColorGaussKernelOneParameterFixedProbe
import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.OperatorDependencies.SU2BFSSPhysicalDomainL6G7ZActualSourceFullL2UnitaryGaugeRepresentationProbe
import Mathlib.Algebra.Group.Subgroup.Lattice

/-!
L6H5E8M — exact original SU(2) Gauss joint kernel equals
the fixed-vector space for the ABSTRACT SUBGROUP generated
by the ORIGINAL source +i color one-parameter curves.

The source curve set is literally
 {g : GaugeGroup 2 | ∃ c t, sourcePlusIGaugeCurve c t = g}.
Its generated subgroup is Subgroup.closure of this set:
NO assertion is made that this subgroup is all of SU(2).
For any v in actual original FullL2, source group fixedness
is a subgroup by source G7Y group law and G7Z inverse;
H5E8L identifies membership in each original color
Gauss kernel with invariance along the corresponding flow.
Thus joint kernel ↔ all generated subgroup elements fix v.

This proves the group-theoretic descent that follows
from the current accepted hypotheses without adding an
unproved SU2 Lie/Pauli basis-generation lemma.
The remaining group generation Ggenerated = ⊤ must be
formally proved before physicalSpace ↔ joint kernel.

Original bosonic inverse pullback, 48-Majorana Fock fiber,
and source positive-i gauge curves remain unchanged.
-/

set_option autoImplicit false
set_option maxHeartbeats 450000
set_option synthInstance.maxHeartbeats 170000

namespace FCP.BFSSSU2PhysicalDomainL6H5E8M
noncomputable section

open OAI.BFSSQuantum
open OAI.BFSSQuantum.AlgebraData
open FCP.BFSSSU2PhysicalDomainL6G6X
open FCP.BFSSSU2PhysicalDomainL6G7U
open FCP.BFSSSU2PhysicalDomainL6G7Y
open FCP.BFSSSU2PhysicalDomainL6G7Z
open FCP.BFSSSU2PhysicalDomainL6H5E8E
open FCP.BFSSSU2PhysicalDomainL6H5E8L

/-- Literally all source-positive-i elementary color curves;
the original source sign is retained. -/
def actualOriginalColorGaugeCurveSet : Set (GaugeGroup 2) :=
  {g | ∃ (c : ColorIndex 2) (t : ℝ),
    sourcePlusIGaugeCurve c t = g}

/-- Algebraic, not topological, generated subgroup of
the exact original source positive-i color curves. -/
def actualOriginalColorGeneratedSubgroup : Subgroup (GaugeGroup 2) :=
  Subgroup.closure actualOriginalColorGaugeCurveSet

/-- For a fixed FullL2 BFSS vector, the group elements
fixing it under the REAL source action form a subgroup.
This is source-exact and does not assume group faithfulness. -/
def actualOriginalGaugeFixedSubgroup
    (v : FullL2 2) : Subgroup (GaugeGroup 2) where
  carrier := {g | actualOriginalFullL2GaugePairCLM g v = v}
  one_mem' := by
    exact actualOriginalFullL2GaugePair_one v
  mul_mem' := by
    intro g h hg hh
    change actualOriginalFullL2GaugePairCLM (g * h) v = v
    rw [← actualOriginalFullL2GaugePair_mul g h v, hh, hg]
  inv_mem' := by
    intro g hg
    change actualOriginalFullL2GaugePairCLM g⁻¹ v = v
    have hcancel := actualOriginalFullL2GaugePair_inv_left g v
    rw [hg] at hcancel
    exact hcancel

/-- The original color source curves belong to their
literal generated subgroup, not a substitute SU2 copy. -/
theorem actualOriginalColorGaugeCurve_mem_generated
    (c : ColorIndex 2) (t : ℝ) :
    sourcePlusIGaugeCurve c t ∈ actualOriginalColorGeneratedSubgroup := by
  exact Subgroup.subset_closure
    (show sourcePlusIGaugeCurve c t ∈
      actualOriginalColorGaugeCurveSet from ⟨c, t, rfl⟩)

/-- Original joint Gauss kernel fixes every element in
the subgroup generated by the ACTUAL color one-parameter
SU2 gauge transformations, with NO full-SU2 claim. -/
theorem actualOriginalJointColorGaussKernel_fixed_generated
    (v : FullL2 2)
    (hker : ∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0)
    (g : GaugeGroup 2)
    (hg : g ∈ actualOriginalColorGeneratedSubgroup) :
    actualOriginalFullL2GaugePairCLM g v = v := by
  have hsubset :
      actualOriginalColorGaugeCurveSet ⊆
        (actualOriginalGaugeFixedSubgroup v : Set (GaugeGroup 2)) := by
    intro x hx
    rcases hx with ⟨c, t, rfl⟩
    exact (actualOriginalColorGenerator_kernel_iff_colorFlow_fixed
      c v).mp (hker c) t
  have hle : actualOriginalColorGeneratedSubgroup ≤
      actualOriginalGaugeFixedSubgroup v :=
    (Subgroup.closure_le (K := actualOriginalGaugeFixedSubgroup v)).mpr hsubset
  exact hle hg

/-- Reverse direction is immediate from the accepted
one-parameter kernel characterization and inclusion of
each source curve in its generated subgroup. -/
theorem actualOriginalGeneratedFixed_implies_jointColorGaussKernel
    (v : FullL2 2)
    (hfixed : ∀ g : GaugeGroup 2,
      g ∈ actualOriginalColorGeneratedSubgroup →
        actualOriginalFullL2GaugePairCLM g v = v) :
    ∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0 := by
  intro c
  apply (actualOriginalColorGenerator_kernel_iff_colorFlow_fixed c v).mpr
  intro t
  exact hfixed (sourcePlusIGaugeCurve c t)
    (actualOriginalColorGaugeCurve_mem_generated c t)

/-- EXACT accepted mathematical bridge to the generated
color-curve gauge subgroup. PhysicalSpace equality requires
an independently proven Ggenerated = top in GaugeGroup 2. -/
theorem actualOriginalJointColorGaussKernel_iff_generatedGaugeFixed
    (v : FullL2 2) :
    (∀ c : ColorIndex 2,
      ∃ hdom : v ∈ actualOriginalColorGeneratorDomainSubmodule c,
        actualOriginalColorGeneratorLinear c ⟨v, hdom⟩ = 0) ↔
    (∀ g : GaugeGroup 2,
      g ∈ actualOriginalColorGeneratedSubgroup →
        actualOriginalFullL2GaugePairCLM g v = v) := by
  constructor
  · exact actualOriginalJointColorGaussKernel_fixed_generated v
  · exact actualOriginalGeneratedFixed_implies_jointColorGaussKernel v

#print axioms actualOriginalColorGaugeCurveSet
#print axioms actualOriginalColorGeneratedSubgroup
#print axioms actualOriginalGaugeFixedSubgroup
#print axioms actualOriginalColorGaugeCurve_mem_generated
#print axioms actualOriginalJointColorGaussKernel_fixed_generated
#print axioms actualOriginalGeneratedFixed_implies_jointColorGaussKernel
#print axioms actualOriginalJointColorGaussKernel_iff_generatedGaugeFixed
#check @actualOriginalJointColorGaussKernel_iff_generatedGaugeFixed

end
end FCP.BFSSSU2PhysicalDomainL6H5E8M
