import OAI.MathematicalPhysics.BFSS.Contrib.Kotler.SU2BFSSPhysicalDomainS1V52K1D8OriginalSpin48TwoSignUpperBoundProbe

/-!
K1D9 — explicit negative central scalar membership in actual source Spin48.

Mathlib's spinGroup is pinGroup intersect the even Clifford subalgebra;
pinGroup in turn requires both Lipschitz-group membership through actual
units generated by Clifford ι(v) and Clifford-unitarity.
We construct -1 as the product of opposite unit-vector generators.
The chosen v is a source-exact original 48-real unit coordinate vector.

This does NOT yet prove its original source vector action is trivial
or a two-sign kernel equality. CANDIDATE, NOT QUALIFIED.
-/

set_option autoImplicit false
set_option maxHeartbeats 900000

namespace FCP.BFSSS1V52K1D9
noncomputable section
open FCP.BFSSS1V0

private abbrev Q : QuadraticForm ℝ Source48Vector := source48Quadratic
private abbrev C := CliffordAlgebra Q

/-- For any real source quadratic unit vector, negative Clifford one is
in the actual Mathlib spinGroup by two original Clifford generators.
This uses no assumed spinor representation or abstract covering. -/
theorem sourceSpin48_neg_one_mem_of_unitVector
    (v : Source48Vector) (hv : Q v = 1) :
    (-1 : C) ∈ spinGroup Q := by
  have hsq : CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q v = 1 := by
    simpa only [hv, map_one] using (CliffordAlgebra.ι_sq_scalar Q v)
  have hsqNeg : CliffordAlgebra.ι Q (-v) * CliffordAlgebra.ι Q (-v) = 1 := by
    simpa only [map_neg, neg_mul_neg] using hsq
  let u : Cˣ :=
    ⟨CliffordAlgebra.ι Q v, CliffordAlgebra.ι Q v, hsq, hsq⟩
  let w : Cˣ :=
    ⟨CliffordAlgebra.ι Q (-v), CliffordAlgebra.ι Q (-v), hsqNeg, hsqNeg⟩
  -- Do not use `change` to expand the Lipschitz subgroup. Its definition
  -- contains a large `Cˣ` coercion / set-preimage closure expression and
  -- made Lean 4.34.1 exhaust elaboration heartbeats in strict run 40624928666.
  -- Feed the actual source generator to the library inclusion theorem.
  have hu : u ∈ lipschitzGroup Q := by
    exact Subgroup.subset_closure
      (show (u : C) ∈ Set.range (CliffordAlgebra.ι Q) from ⟨v, rfl⟩)
  have hw : w ∈ lipschitzGroup Q := by
    exact Subgroup.subset_closure
      (show (w : C) ∈ Set.range (CliffordAlgebra.ι Q) from ⟨-v, rfl⟩)
  have hneg : ((u * w : Cˣ) : C) = -1 := by
    change CliffordAlgebra.ι Q v * CliffordAlgebra.ι Q (-v) = -1
    rw [map_neg, mul_neg, hsq]
  have hunit : (-1 : C) ∈ unitary C := by
    change star (-1 : C) * (-1 : C) = 1 ∧
      (-1 : C) * star (-1 : C) = 1
    constructor <;> simp
  have hpin : (-1 : C) ∈ pinGroup Q := by
    rw [← hneg]
    exact (pinGroup.units_mem_iff).2 ⟨mul_mem hu hw, by simpa only [hneg] using hunit⟩
  have heven : (-1 : C) ∈ CliffordAlgebra.even Q := by
    exact (CliffordAlgebra.even Q).neg_mem (CliffordAlgebra.even Q).one_mem
  exact (spinGroup.mem_iff).2 ⟨hpin, heven⟩

/-- The exact original 48-label positive-definite form possesses a
unit coordinate vector; hence negative one has genuine Spin membership.
This does not yet assert triviality of the induced real-vector action. -/
theorem originalSourceSpin48_neg_one_mem :
    (-1 : C) ∈ spinGroup Q := by
  let v : Source48Vector := fun j =>
    if j = ((0 : Fin 24), (0 : Fin 2)) then 1 else 0
  have hv : Q v = 1 := by
    simp [source48Quadratic, QuadraticMap.weightedSumSquares_apply, v]
  exact sourceSpin48_neg_one_mem_of_unitVector v hv

#print axioms sourceSpin48_neg_one_mem_of_unitVector
#print axioms originalSourceSpin48_neg_one_mem

end
end FCP.BFSSS1V52K1D9
